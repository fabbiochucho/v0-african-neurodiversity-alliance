# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypasses RLS. Used by
# lib/supabase/service.ts for payment routes (Flutterwave initialize/verify/
# webhook, anonymous donations). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave (https://dashboard.flutterwave.com > Settings > API Keys)
FLUTTERWAVE_SECRET_KEY=
# Optional: only needed if you use the /api/payments/flutterwave/webhook route.
# Set this to the same value configured as your webhook's secret hash in the
# Flutterwave dashboard.
FLUTTERWAVE_SECRET_HASH=

# Public base URL of this app, used to build Flutterwave redirect URLs, etc.
# e.g. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=

# Resend (https://resend.com/api-keys) — used to send IEP progress report emails.
RESEND_API_KEY=
# Optional: verified "from" address for outgoing report emails.
RESEND_FROM_EMAIL=
