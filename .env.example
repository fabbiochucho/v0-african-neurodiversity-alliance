# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypasses RLS. Used by
# lib/supabase/service.ts for payment routes (Flutterwave initialize/verify/
# webhook, anonymous donations). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave (https://dashboard.flutterwave.com > Settings > API Keys)
FLUTTERWAVE_SECRET_KEY=
# Optional: only needed if you use the /api/payments/flutterwave/webhook route.
# Set this to the same value configured as your webhook's secret hash in the
# Flutterwave dashboard.
FLUTTERWAVE_SECRET_HASH=

# Public base URL of this app, used to build Flutterwave redirect URLs, etc.
# e.g. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=

# Resend (https://resend.com/api-keys) — used to send IEP progress report emails.
RESEND_API_KEY=
# Optional: verified "from" address for outgoing report emails.
RESEND_FROM_EMAIL=

# --- Phase 1 cross-app federation (optional, see lib/federation/) ---------
# Linking this app ("alliance") with the sibling Neu Rafiki app is entirely
# opt-in: leave all three of these unset and the app behaves exactly as it
# does today (no "Connect account" UI, no imports, no public resources API
# consumption from Neu Rafiki).

# Base URL of the sibling Neu Rafiki deployment (e.g. https://neurafiki.example.com).
# Its presence is the single flag this app uses to decide federation is enabled
# (see lib/federation/config.ts#isFederationEnabled).
NEXT_PUBLIC_NEURAFIKI_APP_URL=

# This app's own Ed25519 private key (PKCS8 PEM), used to sign the link/request
# tokens this app issues. Real newlines are replaced with the literal two
# characters \n so the whole key fits on one env var line.
# Generate a keypair with:
#   node -e "import('jose').then(async ({generateKeyPair, exportPKCS8, exportSPKI}) => { const {publicKey, privateKey} = await generateKeyPair('EdDSA', { extractable: true }); console.log('PRIVATE:', (await exportPKCS8(privateKey)).replace(/\n/g,'\\n')); console.log('PUBLIC:', (await exportSPKI(publicKey)).replace(/\n/g,'\\n')); })"
# Use the PRIVATE line here, and send the PUBLIC line to whoever operates the
# sibling Neu Rafiki deployment (they need it as their FEDERATION_ALLIANCE_PUBLIC_KEY).
FEDERATION_PRIVATE_KEY=

# The sibling Neu Rafiki app's Ed25519 PUBLIC key (SPKI PEM, same \n-escaping),
# used to verify tokens issued by Neu Rafiki. Get this from whoever generated
# Neu Rafiki's keypair with the same command above (the PUBLIC line).
FEDERATION_NEURAFIKI_PUBLIC_KEY=
